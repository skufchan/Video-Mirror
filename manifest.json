{
  "manifest_version": 3,
  "name": "Video Mirror",
  "version": "1.2.0",
  "description": "Отражает видео по горизонтали на веб-страницах. Позволяет Отзеркаливать видео на YouTube, ВК Видео и прочих сервисах.",
  "permissions": ["storage"],
  "action": {
  "default_popup": "popup.html",
  "default_icon": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
    }
  },
  "background": {
  "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-mirror": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Включить или выключить отзеркаливание"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}